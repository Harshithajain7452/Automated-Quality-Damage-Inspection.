{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated QA inspector profile document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Inspector display name."
        },
        "role": {
          "type": "string",
          "enum": ["inspector"],
          "description": "Standard inspector role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "InspectionRecord": {
      "title": "InspectionRecord",
      "description": "Automated quality and damage inspection record with AI findings and optional QA sign-off override.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the inspector who created the record."
        },
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Lot or shipment batch identifier."
        },
        "assetLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Inspected part, parcel, or asset label."
        },
        "domainProfile": {
          "type": "string",
          "enum": ["manufacturing", "logistics", "automotive", "electronics", "infrastructure"],
          "description": "Inspection domain profile."
        },
        "toleranceStandard": {
          "type": "string",
          "enum": ["strict", "standard", "triage"],
          "description": "Applied tolerance threshold."
        },
        "verdict": {
          "type": "string",
          "enum": ["PASS", "CONDITIONAL", "FAIL"],
          "description": "Effective quality verdict."
        },
        "aiVerdict": {
          "type": "string",
          "enum": ["PASS", "CONDITIONAL", "FAIL"],
          "description": "Original automated vision verdict."
        },
        "qualityScore": {
          "type": "number",
          "description": "Quality score from 0 to 100."
        },
        "surfaceCondition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Assessed surface condition."
        },
        "structuralIntegrity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Assessed structural integrity."
        },
        "recommendedAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Recommended disposition action."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Technical inspection summary."
        },
        "inspectorNotes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional QA engineer review notes."
        },
        "defectCount": {
          "type": "integer",
          "description": "Total detected defects count."
        },
        "criticalCount": {
          "type": "integer",
          "description": "Critical severity defects count."
        },
        "defectsSummary": {
          "type": "array",
          "description": "Bounded summary strings of detected defects (max 15)."
        },
        "status": {
          "type": "string",
          "enum": ["open", "reviewed", "archived"],
          "description": "Workflow review state."
        },
        "thumbnailDataUrl": {
          "type": "string",
          "maxLength": 200000,
          "description": "Compressed preview thumbnail data URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "batchId",
        "assetLabel",
        "domainProfile",
        "toleranceStandard",
        "verdict",
        "aiVerdict",
        "qualityScore",
        "surfaceCondition",
        "structuralIntegrity",
        "recommendedAction",
        "summary",
        "inspectorNotes",
        "defectCount",
        "criticalCount",
        "defectsSummary",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "DefectFinding": {
      "title": "DefectFinding",
      "description": "Individual localized defect finding belonging to an inspection record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID matching parent inspection."
        },
        "inspectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent inspection document ID."
        },
        "defectType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Classified defect category."
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "MAJOR", "MINOR"],
          "description": "Defect severity level."
        },
        "confidence": {
          "type": "number",
          "description": "Detection confidence between 0 and 1."
        },
        "locationDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Human-readable defect location."
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Recommended corrective action."
        },
        "ymin": {
          "type": "integer",
          "description": "Normalized top coordinate (0-1000)."
        },
        "xmin": {
          "type": "integer",
          "description": "Normalized left coordinate (0-1000)."
        },
        "ymax": {
          "type": "integer",
          "description": "Normalized bottom coordinate (0-1000)."
        },
        "xmax": {
          "type": "integer",
          "description": "Normalized right coordinate (0-1000)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "ownerId",
        "inspectionId",
        "defectType",
        "severity",
        "confidence",
        "locationDescription",
        "remediation",
        "ymin",
        "xmin",
        "ymax",
        "xmax",
        "createdAt"
      ]
    },
    "InspectionStandard": {
      "title": "InspectionStandard",
      "description": "Custom QA standard preset configured by an inspector.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Standard profile name."
        },
        "domainProfile": {
          "type": "string",
          "enum": ["manufacturing", "logistics", "automotive", "electronics", "infrastructure"],
          "description": "Target domain profile."
        },
        "toleranceStandard": {
          "type": "string",
          "enum": ["strict", "standard", "triage"],
          "description": "Strictness tier."
        },
        "passThreshold": {
          "type": "integer",
          "description": "Minimum score required to pass (0-100)."
        },
        "defectFocus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Custom focus instructions for automated vision inspection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "domainProfile",
        "toleranceStandard",
        "passThreshold",
        "defectFocus",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private inspector profile keyed by Firebase Auth UID."
    },
    "/inspections/{inspectionId}": {
      "schema": { "$ref": "#/entities/InspectionRecord" },
      "description": "Saved quality and damage inspection records owned by the creating inspector."
    },
    "/inspections/{inspectionId}/findings/{findingId}": {
      "schema": { "$ref": "#/entities/DefectFinding" },
      "description": "Localized defect findings with normalized bounding coordinates under an inspection record."
    },
    "/standards/{standardId}": {
      "schema": { "$ref": "#/entities/InspectionStandard" },
      "description": "Custom inspection tolerance profiles saved by an inspector."
    }
  }
}
